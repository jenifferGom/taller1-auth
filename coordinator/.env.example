# Copia este archivo como .env y llena los valores (el .env NUNCA se sube al repositorio)
PORT=5000

# Mínimo 32 caracteres y EXACTAMENTE la misma que en auth-service/.env
JWT_SECRET=mi_clave_secreta_123456789

# URL del auth-service. El coordinador le pregunta cada 3 s cuánto dura la sesión,
# para aplicar en vivo los cambios de JWT_EXPIRES_IN a los jugadores conectados.
# Local: http://localhost:4000   ·   Con ngrok: la URL https del túnel del auth
AUTH_URL=https://episode-headrest-ocean.ngrok-free.dev

# Cada cuánto se envía ping a los clientes para detectar conexiones muertas (ms)
HEARTBEAT_MS=30000
