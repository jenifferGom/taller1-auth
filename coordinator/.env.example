# Copia este archivo como .env y llena los valores (el .env NUNCA se sube al repositorio)
# Cada computador corre UN coordinador, con un ID distinto:
#   PC 1: npm run start:a     PC 2: npm run start:b     PC 3: npm run start:c

# Mínimo 32 caracteres y EXACTAMENTE la misma que en auth-service/.env
JWT_SECRET=mi_clave_secreta_es_1234567890000
# URL del auth-service: también es el DIRECTORIO (POST /heartbeat, GET /peers, GET /coordinator)
# Local: http://localhost:4000   ·   Con ngrok: la URL https del túnel del auth
AUTH_URL=https://episode-headrest-ocean.ngrok-free.dev
# Cada cuánto se envía ping a los clientes para detectar conexiones muertas (ms)
HEARTBEAT_MS=30000
# Opcional: clave compartida del mesh (la misma en todos los computadores)
# MESH_SECRET=

# ── Este coordinador ──
# Puerto local. El túnel se abre con:  ngrok http 5001
COORD_PORT=5001
# URL de ngrok de ESTE computador, con wss://  (en local: ws://localhost:5001)
# Por aquí entran los jugadores (/connect) y también los otros coordinadores (/peer): no hace falta otro túnel
COORD_PUBLIC_URL=ws://localhost:5001
