# Copia este archivo como .env y llena los valores (el .env NUNCA se sube al repositorio)
# Cada computador corre UN coordinador, con un ID distinto:
#   PC 1: npm run start:a     PC 2: npm run start:b     PC 3: npm run start:c

# Mínimo 32 caracteres y EXACTAMENTE la misma que en auth-service/.env
JWT_SECRET=mi_clave_secreta_es_1234567890000
# URLs de TODOS los auth-services (Taller 7), separadas por coma. Son también el DIRECTORIO (heartbeat, peers,
# coordinador). Se prueba con el primero; si no responde, con el siguiente. Si una réplica dice "not_leader", se usa el líder.
# Local: http://localhost:4001,http://localhost:4002,http://localhost:4003   ·   Con ngrok: las URLs https de los túneles
#   AUTH_URLS=https://aaaa.ngrok-free.dev,https://bbbb.ngrok-free.dev,https://cccc.ngrok-free.dev
AUTH_URLS=http://localhost:4000
# Cada cuánto se envía ping a los clientes para detectar conexiones muertas (ms)
HEARTBEAT_MS=30000
# Opcional: clave compartida del mesh (la misma en todos los computadores)
# MESH_SECRET=

# ── Este coordinador ──
# Puerto local. El túnel se abre con:  ngrok http 5001
COORD_PORT=5001
# URL de ngrok de ESTE computador, con wss://  (en local: ws://localhost:5001)
# Por aquí entran los jugadores (/connect) y también los otros coordinadores (/peer): no hace falta otro túnel
COORD_PUBLIC_URL=ws://localhost:5001

# ── Guaro Royal: salas de parqués (todas opcionales; estos son los valores por defecto) ──
# Partida pública: mínimo y máximo de jugadores (entre 2 y 4)
# SALA_PUBLICA_MIN=2
# SALA_PUBLICA_MAX=4
# Sala privada: rango de jugadores que puede elegir el anfitrión
# SALA_PRIVADA_MIN=2
# SALA_PRIVADA_MAX=4
# Si hay al menos el mínimo buscando, cuánto se espera a que lleguen más antes de arrancar (ms)
# PUBLICA_ESPERA_MS=20000
# Cuenta regresiva en la sala de espera pública, para elegir Modo Agua (ms)
# PUBLICA_CUENTA_MS=10000
# Nivel de shots de las partidas públicas: suave | normal | guaro
# PUBLICA_NIVEL=normal
# Una sala sin nadie conectado se cierra después de este tiempo (ms)
# SALA_ABANDONADA_MS=120000

# ── Examen final: chat distribuido (todas opcionales; estos son los valores por defecto) ──
# CHAT_MAX_LARGO=200          caracteres por mensaje
# CHAT_HISTORIAL=50           últimos mensajes que guarda cada coordinador en memoria
# CHAT_POR_VENTANA=5          rate limit: máximo de mensajes…
# CHAT_VENTANA_MS=10000       …en esta ventana de tiempo
# CHAT_AVISOS=3               avisos de "vas muy rápido" antes de silenciar
# CHAT_SILENCIO_MS=30000      tiempo de silencio por spam
# CHAT_MAX_DESFASE_MS=60000   un peer con el reloj adelantado más que esto no arrastra el reloj del chat

# ── Examen final: modo espectador ──
# SPECTATORS_MAX=100          espectadores por coordinador (el siguiente recibe 4003 y la página busca otro)
# SPECTATOR_STATE_EVERY=2     el estado del mundo se manda a los espectadores 1 de cada N ticks (2 → 10 Hz)
