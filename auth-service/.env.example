# Copia este archivo como .env y llena los valores (el .env NUNCA se sube al repositorio)
PORT=4000

# Mínimo 32 caracteres y EXACTAMENTE igual en coordinator/.env. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=mi_clave_secreta_es_

# Duración de los tokens: 30s, 15m, 1h, 2d...
# Se puede cambiar con el servicio encendido: al guardar el archivo se aplica sin reiniciar
JWT_EXPIRES_IN=1h

# Client ID de Google Cloud (OAuth, tipo "Aplicación web"). Termina en .apps.googleusercontent.com
# No es secreto (también lo usa el botón de Google), pero va aquí y no en el repositorio
GOOGLE_CLIENT_ID=283535277926-u4m6f7fga4vo41budsb17ma7bmhidmau.apps.googleusercontent.com

BCRYPT_ROUNDS=10
DB_PATH=users.db

# Directory service (Taller 6) — opcionales
# Segundos sin heartbeat para dar por muerto a un coordinador (el PDF pide 6 s = 3 ciclos de 2 s)
COORDINATOR_TTL_MS=6000
# Durante cuánto tiempo cuenta una asignación de GET /coordinator como "carga pendiente" (ms; 0 = desactivado)
PENDING_TTL_MS=5000

# ───────────────────────── Taller 7: varios auth-services ─────────────────────────
# Cada computador corre UN auth-service, con un nombre distinto (el nombre sale del comando):
#   PC 1: npm run start:a     PC 2: npm run start:b     PC 3: npm run start:c
#   (o  npm start -- mi-nombre).  Sin nombre y sin AUTH_URLS, arranca solo como "auth-1" y es su propio líder.
# La URL de ngrok de ESTE computador (el túnel se abre con:  ngrok http 4000). Si es solo local: http://localhost:4000
# El mesh entre auth-services usa esta MISMA URL (ruta /peer): no hace falta otro túnel.
AUTH_PUBLIC_URL=http://localhost:4000
# Las URLs de TODOS los auth-services, separadas por coma (la MISMA lista en cada computador; la propia se ignora).
# Con ellas los nodos se descubren y se conectan entre sí. Con un solo auth-service déjala vacía.
#   AUTH_URLS=https://aaaa.ngrok-free.dev,https://bbbb.ngrok-free.dev,https://cccc.ngrok-free.dev
AUTH_URLS=http://localhost:4000
# Opcional: clave compartida del mesh (la misma en todos los computadores)
# MESH_SECRET=
# Opcional: cuántas escrituras puede ir atrasada una réplica y aun así emitir tokens (si no, manda al cliente al líder)
MAX_REPLICA_LAG=10
