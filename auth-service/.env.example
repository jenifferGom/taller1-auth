# Copia este archivo como .env y llena los valores (el .env NUNCA se sube al repositorio)
PORT=4000

# Mínimo 32 caracteres y EXACTAMENTE igual en coordinator/.env. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=mi_clave_secreta_es_1234567890000

# Duración de los tokens: 30s, 15m, 1h, 2d...
# Se puede cambiar con el servicio encendido: al guardar el archivo se aplica sin reiniciar
JWT_EXPIRES_IN=1h

# Client ID de Google Cloud (OAuth, tipo "Aplicación web"). Termina en .apps.googleusercontent.com
# No es secreto (también lo usa el botón de Google), pero va aquí y no en el repositorio
GOOGLE_CLIENT_ID=283535277926-u4m6f7fga4vo41budsb17ma7bmhidmau.apps.googleusercontent.com

BCRYPT_ROUNDS=10
DB_PATH=users.db

# Directory service (Taller 6) — opcionales
# Segundos sin heartbeat para dar por muerto a un coordinador (el PDF pide 6 s = 3 ciclos de 2 s)
COORDINATOR_TTL_MS=6000
# Durante cuánto tiempo cuenta una asignación de GET /coordinator como "carga pendiente" (ms; 0 = desactivado)
PENDING_TTL_MS=5000
