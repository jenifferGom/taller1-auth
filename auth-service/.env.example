# Copia este archivo como .env y llena los valores
PORT=4000

# DEBE ser exactamente la misma en coordinator/.env
JWT_SECRET=mi_clave_secreta_123456789

# Duración del token (formato de jsonwebtoken: 30s, 15m, 1h...)
# En la sustentación se cambia a 30s para demostrar el token vencido
JWT_EXPIRES_IN=30m

BCRYPT_ROUNDS=10
DB_PATH=users.db
